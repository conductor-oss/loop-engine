{
  "objective": "Clean the customer dataset so it satisfies the data-quality contract.",
  "acceptance_criteria": "Every row must have non-null id, name, email and age; emails must be validly formatted; age must be an integer in [0,120]; there must be no duplicate ids.",
  "context": "The raw dataset and the contract are provided in extension_params. A Python worker performs the cleaning; a Python worker enforces the contract.",
  "planner_workflow": "loop_planner",
  "actor_workflow": "data_cleaning_actor",
  "delegate_actor_workflow": "data_cleaning_actor",
  "evaluator_workflow": "data_quality_evaluator",
  "max_iterations": 4,
  "max_retries": 3,
  "max_replans": 0,
  "token_budget": 400000,
  "enable_human": false,
  "escalate_on_limit": false,
  "llm_provider": "anthropic",
  "llm_model": "claude-opus-4-7",
  "extension_params": {
    "dataset": [
      {"id": 1, "name": " Alice ", "email": "ALICE@EXAMPLE.COM", "age": "30"},
      {"id": 1, "name": "Alice", "email": "alice@example.com", "age": "30"},
      {"id": 2, "name": "", "email": "not-an-email", "age": "45"},
      {"id": 3, "name": "Bob", "email": "bob@example.com", "age": "abc"},
      {"id": 4, "name": "Cy", "email": "cy@example.com", "age": "200"},
      {"id": 5, "name": "Dee", "email": "dee@example.com", "age": "27"}
    ],
    "contract": {
      "required_fields": ["id", "name", "email", "age"],
      "unique_field": "id",
      "email_field": "email",
      "age_field": "age",
      "age_min": 0,
      "age_max": 120
    }
  }
}
